                                <div class="p-3 bg-white border border-slate-200 rounded-lg shadow-sm">
                                    <h3 class="font-bold text-slate-900">${r.name}</h3>
                                    <p class="text-slate-600 text-[11px]">${r.designation}, ${r.organization}</p>
                                    <p class="text-slate-500 text-[11px] mt-1"><i class="fa-solid fa-phone text-slate-400"></i> ${r.phone}</p>
                                </div>
                            `).join('')}
                        </div>
                    </div>` : ''}
                    ` : ''}
                </div>
            </div>
            `;
        }

        // 3. Corporate Elegant Two-Column Layout Template
        function generateCorporateTemplate(d) {
            return `
            <div class="grid grid-cols-12 min-h-[297mm]">
                <!-- Sidebar Column (4 Cols) -->
                <div class="col-span-4 bg-slate-100 p-6 border-r border-slate-200 flex flex-col gap-6 text-xs">
                    <div>
                        <h1 class="text-xl font-bold text-bdGreen uppercase leading-tight">${d.name}</h1>
                        <p class="text-slate-600 font-semibold mt-1">${d.title}</p>
                    </div>

                    <div class="space-y-2">
                        <h2 class="font-bold text-slate-900 uppercase border-b border-slate-300 pb-1 text-[11px]">Contact</h2>
                        ${d.phone ? `<p class="text-slate-700"><i class="fa-solid fa-phone text-bdGreen w-4"></i> ${d.phone}</p>` : ''}
                        ${d.email ? `<p class="text-slate-700 break-all"><i class="fa-solid fa-envelope text-bdGreen w-4"></i> ${d.email}</p>` : ''}
                        ${d.website ? `<p class="text-slate-700 break-all"><i class="fa-solid fa-globe text-bdGreen w-4"></i> ${d.website}</p>` : ''}
                        ${d.presentAddress ? `<p class="text-slate-700"><i class="fa-solid fa-location-dot text-bdGreen w-4"></i> ${d.presentAddress}</p>` : ''}
                    </div>

                    ${d.skills.length > 0 ? `
                    <div>
                        <h2 class="font-bold text-slate-900 uppercase border-b border-slate-300 pb-1 text-[11px] mb-2">Skills</h2>
                        <div class="space-y-1">
                            ${d.skills.map(s => `<div class="bg-white px-2 py-1 rounded text-slate-700 border border-slate-200 font-medium">${s}</div>`).join('')}
                        </div>
                    </div>` : ''}

                    ${currentFormat === '2page' ? `
                    <div>
                        <h2 class="font-bold text-slate-900 uppercase border-b border-slate-300 pb-1 text-[11px] mb-2">Personal Info</h2>
                        <div class="space-y-1.5 text-[11px] text-slate-700">
                            <p><span class="font-semibold block text-slate-500">Father:</span> ${d.fatherName}</p>
                            <p><span class="font-semibold block text-slate-500">Mother:</span> ${d.motherName}</p>
                            <p><span class="font-semibold block text-slate-500">DOB:</span> ${d.dob}</p>
                            <p><span class="font-semibold block text-slate-500">NID:</span> ${d.nid}</p>
                            <p><span class="font-semibold block text-slate-500">Status:</span> ${d.maritalStatus}</p>
                        </div>
                    </div>` : ''}
                </div>

                <!-- Main Content Column (8 Cols) -->
                <div class="col-span-8 p-6 text-xs space-y-6">
                    ${d.objective ? `
                    <div>
                        <h2 class="text-sm font-bold text-bdGreen uppercase tracking-wider mb-2 border-b pb-1">Executive Summary</h2>
                        <p class="text-slate-700 leading-relaxed text-justify">${d.objective}</p>
                    </div>` : ''}

                    ${experiences.length > 0 ? `
                    <div>
                        <h2 class="text-sm font-bold text-bdGreen uppercase tracking-wider mb-3 border-b pb-1">Work History</h2>
                        <div class="space-y-4">
                            ${experiences.map(exp => `
                                <div>
                                    <div class="flex justify-between items-baseline">
                                        <h3 class="font-bold text-slate-900">${exp.designation}</h3>
                                        <span class="text-[11px] font-semibold text-slate-500">${exp.duration}</span>
                                    </div>
                                    <p class="text-bdGreen font-medium text-[11px]">${exp.company}</p>
                                    ${exp.details ? `<p class="text-slate-600 mt-1">${exp.details}</p>` : ''}
                                </div>
                            `).join('')}
                        </div>
                    </div>` : ''}

                    ${educations.length > 0 ? `
                    <div>
                        <h2 class="text-sm font-bold text-bdGreen uppercase tracking-wider mb-3 border-b pb-1">Education</h2>
                        <div class="space-y-3">
                            ${educations.map(edu => `
                                <div>
                                    <div class="flex justify-between font-bold text-slate-800">
                                        <span>${edu.degree}</span>
                                        <span>${edu.year}</span>
                                    </div>
                                    <p class="text-slate-600">${edu.institution}</p>
                                    <p class="text-slate-500 text-[11px]">Result: ${edu.result}</p>
                                </div>
                            `).join('')}
                        </div>
                    </div>` : ''}

                    ${currentFormat === '2page' && references.length > 0 ? `
                    <div class="page-break my-4 border-t border-slate-200 pt-4">
                        <h2 class="text-sm font-bold text-bdGreen uppercase tracking-wider mb-3 border-b pb-1">References</h2>
                        <div class="space-y-3">
                            ${references.map(r => `
                                <div class="p-2 border border-slate-200 rounded">
                                    <p class="font-bold text-slate-800">${r.name}</p>
                                    <p class="text-slate-600 text-[11px]">${r.designation} - ${r.organization}</p>
                                    <p class="text-slate-500 text-[11px]">Phone: ${r.phone}</p>
                                </div>
                            `).join('')}
                        </div>
                    </div>` : ''}
                </div>
            </div>
            `;
        }
    </script>
</body>
</html>
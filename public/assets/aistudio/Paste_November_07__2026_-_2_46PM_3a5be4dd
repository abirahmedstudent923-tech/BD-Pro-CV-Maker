        function renderReferenceInputs() {
            const container = document.getElementById('referenceList');
            container.innerHTML = '';
            references.forEach((ref, index) => {
                container.innerHTML += `
                    <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg space-y-2 relative">
                        <button onclick="removeReference(${index})" class="absolute top-2 right-2 text-rose-500 hover:text-rose-700 text-xs">

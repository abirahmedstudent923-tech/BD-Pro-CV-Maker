        // Format Switcher (1 Page vs 2 Page)
        function setCVFormat(format) {
            currentFormat = format;
            const btn1 = document.getElementById('btn1Page');
            const btn2 = document.getElementById('btn2Page');
            const badge = document.getElementById('pageCountBadge');

            if (format === '1page') {
                btn1.className = "px-3 py-1 text-xs font-medium rounded-md transition bg-white text-bdGreen shadow";
                btn2.className = "px-3 py-1 text-xs font-medium rounded-md transition text-slate-600 hover:text-slate-900";
                badge.innerText = "ফরম্যাট: ১ পৃষ্ঠা (Resume)";
            } else {
                btn2.className = "px-3 py-1 text-xs font-medium rounded-md transition bg-white text-bdGreen shadow";
                btn1.className = "px-3 py-1 text-xs font-medium rounded-md transition text-slate-600 hover:text-slate-900";
                badge.innerText = "ফরম্যাট: ২ পৃষ্ঠা (Detailed CV)";
            }
            updateCV();
        }

        // Apply Preset Role Content
        function applyRolePreset(roleKey) {
            if (!roleKey || !presets[roleKey]) return;
            const data = presets[roleKey];
            
            document.getElementById('jobTitle').value = data.title;
            document.getElementById('objective').value = data.summary;
            document.getElementById('skillsInput').value = data.skills;

            if (data.exp && data.exp.length > 0) {
                experiences = data.exp.map(e => ({ ...e }));
                renderExperienceInputs();
            }

            updateCV();
        }

        // Render Dynamic Input Fields
        function renderExperienceInputs() {
            const container = document.getElementById('experienceList');
            container.innerHTML = '';
            experiences.forEach((exp, index) => {
                container.innerHTML += `
                    <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg space-y-2 relative">
                        <button onclick="removeExperience(${index})" class="absolute top-2 right-2 text-rose-500 hover:text-rose-700 text-xs">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                        <div class="grid grid-cols-2 gap-2">
                            <input type="text" placeholder="প্রতিষ্ঠান (Company)" value="${exp.company}" oninput="experiences[${index}].company = this.value; updateCV();" class="p-1.5 border rounded text-xs">
                            <input type="text" placeholder="পদবী (Designation)" value="${exp.designation}" oninput="experiences[${index}].designation = this.value; updateCV();" class="p-1.5 border rounded text-xs">
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <input type="text" placeholder="সময়কাল (Duration)" value="${exp.duration}" oninput="experiences[${index}].duration = this.value; updateCV();" class="p-1.5 border rounded text-xs">
                            <input type="text" placeholder="লোকেশন (Location)" value="${exp.location}" oninput="experiences[${index}].location = this.value; updateCV();" class="p-1.5 border rounded text-xs">
                        </div>
                        <textarea placeholder="দায়িত্ব ও অর্জন (Responsibilities & Achievements)" oninput="experiences[${index}].details = this.value; updateCV();" class="w-full p-1.5 border rounded text-xs" rows="2">${exp.details}</textarea>
                    </div>
                `;
            });
        }

        function addExperienceItem() {
            experiences.push({ company: '', designation: '', duration: '', location: '', details: '' });
            renderExperienceInputs();
            updateCV();
        }

        function removeExperience(index) {
            experiences.splice(index, 1);
            renderExperienceInputs();
            updateCV();
        }

        function renderEducationInputs() {

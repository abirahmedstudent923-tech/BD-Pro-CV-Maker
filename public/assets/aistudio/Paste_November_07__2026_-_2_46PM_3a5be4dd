        // Main CV Render Trigger
        function updateCV() {
            renderCV();
        }

        function renderCV() {
            const style = document.getElementById('templateStyle').value;
            const container = document.getElementById('cvDocument');

            // Gather inputs
            const data = {
                name: document.getElementById('fullName').value || 'আপনার নাম',
                title: document.getElementById('jobTitle').value || 'পদবী',
                email: document.getElementById('email').value,
                phone: document.getElementById('phone').value,
                presentAddress: document.getElementById('presentAddress').value,
                website: document.getElementById('website').value,
                objective: document.getElementById('objective').value,
                skills: document.getElementById('skillsInput').value.split(',').map(s => s.trim()).filter(Boolean),
                certifications: document.getElementById('certificationsInput').value.split('\n').filter(Boolean),
                // BD Standard details
                fatherName: document.getElementById('fatherName').value,
                motherName: document.getElementById('motherName').value,
                dob: document.getElementById('dob').value,
                nationality: document.getElementById('nationality').value,
                nid: document.getElementById('nid').value,
                maritalStatus: document.getElementById('maritalStatus').value,
                religion: document.getElementById('religion').value,
                bloodGroup: document.getElementById('bloodGroup').value,
                permanentAddress: document.getElementById('permanentAddress').value,
            };

            if (style === 'classic') {
                container.innerHTML = generateClassicTemplate(data);
            } else if (style === 'modern') {
                container.innerHTML = generateModernTemplate(data);
            } else {
                container.innerHTML = generateCorporateTemplate(data);
            }
        }


<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bangladeshi CV & Resume Builder</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter & Tiro Bangla -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Tiro+Bangla:ital@0;1&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        bdGreen: '#006a4e',
                        bdRed: '#f42a41',
                        slateDark: '#1e293b'
                    },
                    fontFamily: {
                        sans: ['Inter', 'Tiro Bangla', 'sans-serif'],
                        bangla: ['Tiro Bangla', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        /* Print Styles for clean A4 Page output */
        @media print {
            body {
                background: white !important;
                color: black !important;
            }
            .no-print {
                display: none !important;
            }
            .print-only {
                display: block !important;
            }
            .cv-preview-container {
                box-shadow: none !important;
                border: none !important;
                padding: 0 !important;
                margin: 0 !important;
                width: 100% !important;
            }
            .a4-page {
                width: 100% !important;
                min-height: 100vh !important;
                box-shadow: none !important;
                margin: 0 !important;
                padding: 0 !important;
                page-break-after: always;
            }
            .page-break {
                page-break-before: always;
            }
        }

        /* Standard A4 Screen Simulation */
        .a4-page {
            width: 210mm;
            min-height: 297mm;
            background: white;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            margin: 0 auto;
        }

        /* Custom Scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-slate-100 font-sans text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- Top Header Navigation -->
    <header class="bg-bdGreen text-white shadow-md sticky top-0 z-50 no-print">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center text-bdGreen font-bold text-xl shadow">
                    <i class="fa-solid fa-file-contract"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight">BD CV Maker</h1>
                    <p class="text-xs text-green-100">স্মার্ট ও প্রফেশনাল সিভি তৈরি করুন</p>
                </div>
            </div>

            <!-- Role Auto-Fill Quick Action -->
            <div class="flex items-center gap-2 bg-emerald-800/60 px-3 py-1.5 rounded-lg border border-emerald-600/40">
                <i class="fa-solid fa-wand-magic-sparkles text-amber-300"></i>
                <label for="rolePreset" class="text-xs font-medium text-emerald-100 whitespace-nowrap">অটো-ফিল (Preset):</label>
                <select id="rolePreset" onchange="applyRolePreset(this.value)" class="bg-slate-800 text-white text-xs rounded border border-emerald-500/50 px-2 py-1 focus:outline-none focus:ring-1 focus:ring-amber-400">
                    <option value="">-- রোল নির্বাচন করুন --</option>
                    <option value="software">Software Engineer</option>
                    <option value="lecturer">University / College Lecturer</option>
                    <option value="accountant">Accountant / Finance</option>
                    <option value="sales">Sales & Marketing Executive</option>
                    <option value="designer">Graphic & UI/UX Designer</option>
                    <option value="banker">Bank Officer</option>
                </select>
            </div>

            <!-- Header Action Buttons -->
            <div class="flex items-center gap-2">
                <button onclick="window.print()" class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-semibold px-4 py-2 rounded-lg text-sm transition flex items-center gap-2 shadow">
                    <i class="fa-solid fa-print"></i> প্রিন্ট / PDF ডাউনলোড
                </button>
            </div>
        </div>
    </header>

    <!-- Main Workspace Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 flex flex-col lg:flex-row gap-6">

        <!-- Left Column: Input Controls Sidebar (No Print) -->
        <section class="lg:w-1/2 w-full flex flex-col gap-4 no-print max-h-[calc(100vh-5rem)] overflow-y-auto pr-1">
            
            <!-- Controls Toolbar: Format & Template selection -->
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-wrap gap-4 justify-between items-center">
                <div>
                    <label class="text-xs font-semibold uppercase tracking-wider text-slate-500 block mb-1">সিভির ধরন (Pages)</label>
                    <div class="flex rounded-lg bg-slate-100 p-1 border border-slate-200">
                        <button id="btn1Page" onclick="setCVFormat('1page')" class="px-3 py-1 text-xs font-medium rounded-md transition bg-white text-bdGreen shadow">১ পৃষ্ঠা (Resume)</button>
                        <button id="btn2Page" onclick="setCVFormat('2page')" class="px-3 py-1 text-xs font-medium rounded-md transition text-slate-600 hover:text-slate-900">২ পৃষ্ঠা (Detailed CV)</button>
                    </div>
                </div>

                <div>
                    <label class="text-xs font-semibold uppercase tracking-wider text-slate-500 block mb-1">টেমপ্লেট স্টাইল</label>
                    <select id="templateStyle" onchange="renderCV()" class="bg-slate-50 text-slate-700 text-xs rounded-lg border border-slate-300 px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-bdGreen">
                        <option value="classic">Classic Bangladeshi (Official)</option>
                        <option value="modern">Modern Minimalist</option>
                        <option value="corporate">Corporate Elegant</option>
                    </select>
                </div>
            </div>

            <!-- Accordion Form Container -->
            <div class="space-y-3">
                
                <!-- 1. Personal Information -->
                <details class="bg-white rounded-xl shadow-sm border border-slate-200 group" open>
                    <summary class="flex justify-between items-center p-4 cursor-pointer font-semibold text-slate-800 group-open:border-b group-open:border-slate-100 select-none">
                        <span class="flex items-center gap-2 text-bdGreen">
                            <i class="fa-solid fa-user-circle"></i> ব্যক্তিগত তথ্য (Personal Info)
                        </span>
                        <i class="fa-solid fa-chevron-down text-slate-400 group-open:rotate-180 transition-transform"></i>
                    </summary>
                    <div class="p-4 grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">পূর্ণ নাম *</label>
                            <input type="text" id="fullName" value="Md. Tanvir Rahman" oninput="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">পদবী (Designation/Title)</label>
                            <input type="text" id="jobTitle" value="Software Engineer" oninput="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">ইমেইল *</label>
                            <input type="email" id="email" value="tanvir.rahman@example.com" oninput="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">মোবাইল নম্বর *</label>
                            <input type="text" id="phone" value="+880 1712-345678" oninput="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none">
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-xs font-medium text-slate-600 mb-1">বর্তমান ঠিকানা (Present Address)</label>
                            <input type="text" id="presentAddress" value="House #42, Road #09, Block-D, Mirpur-12, Dhaka-1216" oninput="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none">
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-xs font-medium text-slate-600 mb-1">ওয়েবসাইট / লিঙ্কডইন (LinkedIn/GitHub/Portfolio)</label>
                            <input type="text" id="website" value="linkedin.com/in/tanvir-rahman" oninput="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none">
                        </div>
                    </div>
                </details>

                <!-- 2. Career Objective / Summary -->
                <details class="bg-white rounded-xl shadow-sm border border-slate-200 group">
                    <summary class="flex justify-between items-center p-4 cursor-pointer font-semibold text-slate-800 group-open:border-b group-open:border-slate-100 select-none">
                        <span class="flex items-center gap-2 text-bdGreen">
                            <i class="fa-solid fa-bullseye"></i> ক্যারিয়ার অবজেক্টিভ / সামারি
                        </span>
                        <i class="fa-solid fa-chevron-down text-slate-400 group-open:rotate-180 transition-transform"></i>
                    </summary>
                    <div class="p-4 text-sm">
                        <label class="block text-xs font-medium text-slate-600 mb-1">প্রফেশনাল বিবরণ (Executive Summary)</label>
                        <textarea id="objective" rows="4" oninput="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none">Dedicated and detail-oriented Software Engineer with over 3+ years of experience in developing scalable web applications. Passionate about solving complex problems and contributing to innovative tech initiatives in Bangladesh.</textarea>
                    </div>
                </details>

                <!-- 3. Work Experience -->
                <details class="bg-white rounded-xl shadow-sm border border-slate-200 group">
                    <summary class="flex justify-between items-center p-4 cursor-pointer font-semibold text-slate-800 group-open:border-b group-open:border-slate-100 select-none">
                        <span class="flex items-center gap-2 text-bdGreen">
                            <i class="fa-solid fa-briefcase"></i> কর্মসংস্থান ও অভিজ্ঞতা (Work Experience)
                        </span>
                        <i class="fa-solid fa-chevron-down text-slate-400 group-open:rotate-180 transition-transform"></i>
                    </summary>
                    <div class="p-4 space-y-4 text-sm">
                        <div id="experienceList" class="space-y-4">
                            <!-- Dynamic Experience Items insert here -->
                        </div>
                        <button onclick="addExperienceItem()" class="w-full py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold flex items-center justify-center gap-2 border border-slate-300">
                            <i class="fa-solid fa-plus"></i> অভিজ্ঞতা যোগ করুন
                        </button>
                    </div>
                </details>

                <!-- 4. Education -->
                <details class="bg-white rounded-xl shadow-sm border border-slate-200 group">
                    <summary class="flex justify-between items-center p-4 cursor-pointer font-semibold text-slate-800 group-open:border-b group-open:border-slate-100 select-none">
                        <span class="flex items-center gap-2 text-bdGreen">
                            <i class="fa-solid fa-graduation-cap"></i> শিক্ষাগত যোগ্যতা (Education)
                        </span>
                        <i class="fa-solid fa-chevron-down text-slate-400 group-open:rotate-180 transition-transform"></i>
                    </summary>
                    <div class="p-4 space-y-4 text-sm">
                        <div id="educationList" class="space-y-4">
                            <!-- Dynamic Education Items insert here -->
                        </div>
                        <button onclick="addEducationItem()" class="w-full py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold flex items-center justify-center gap-2 border border-slate-300">
                            <i class="fa-solid fa-plus"></i> শিক্ষা যোগ করুন
                        </button>
                    </div>
                </details>

                <!-- 5. Skills & Training/Certifications -->
                <details class="bg-white rounded-xl shadow-sm border border-slate-200 group">
                    <summary class="flex justify-between items-center p-4 cursor-pointer font-semibold text-slate-800 group-open:border-b group-open:border-slate-100 select-none">
                        <span class="flex items-center gap-2 text-bdGreen">
                            <i class="fa-solid fa-code"></i> স্কিল ও ট্রেনিং (Skills & Certifications)
                        </span>
                        <i class="fa-solid fa-chevron-down text-slate-400 group-open:rotate-180 transition-transform"></i>
                    </summary>
                    <div class="p-4 space-y-3 text-sm">
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">দক্ষতা (Skills - Comma separated)</label>
                            <input type="text" id="skillsInput" value="JavaScript, React, Node.js, Python, PostgreSQL, Git, REST APIs, Problem Solving" oninput="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">ট্রেনিং / সার্টিফিকেট (Certifications)</label>
                            <textarea id="certificationsInput" rows="2" oninput="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none" placeholder="যেমন: Professional Web Development - BASIS (2022)">Full Stack Web Development - Programming Hero (2022)&#10;Certified Scrum Master (CSM) - 2023</textarea>
                        </div>
                    </div>
                </details>

                <!-- 6. Bangladeshi Specific Personal Details (Mandatory for 2-Page CV) -->
                <details id="bdPersonalSection" class="bg-white rounded-xl shadow-sm border border-slate-200 group">
                    <summary class="flex justify-between items-center p-4 cursor-pointer font-semibold text-slate-800 group-open:border-b group-open:border-slate-100 select-none">
                        <span class="flex items-center gap-2 text-bdGreen">
                            <i class="fa-solid fa-id-card"></i> ব্যক্তিগত বিস্তারিত (Bangladeshi CV Standard)
                        </span>
                        <span class="text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded font-normal">২ পৃষ্ঠা সিভির জন্য জরুরি</span>
                    </summary>
                    <div class="p-4 grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">পিতার নাম (Father's Name)</label>
                            <input type="text" id="fatherName" value="Md. Abdur Rahman" oninput="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">মাতার নাম (Mother's Name)</label>
                            <input type="text" id="motherName" value="Begum Rokeya" oninput="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">জন্ম তারিখ (Date of Birth)</label>
                            <input type="text" id="dob" value="15th August 1996" oninput="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">জাতীয়তা (Nationality)</label>
                            <input type="text" id="nationality" value="Bangladeshi (By Birth)" oninput="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">জাতীয় পরিচয়পত্র নম্বর (NID No.)</label>
                            <input type="text" id="nid" value="1996269123456789" oninput="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">বৈবাহিক অবস্থা (Marital Status)</label>
                            <select id="maritalStatus" onchange="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none bg-white">
                                <option value="Unmarried">Unmarried (অবিবাহিত)</option>
                                <option value="Married">Married (বিবাহিত)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">ধর্ম (Religion)</label>
                            <input type="text" id="religion" value="Islam" oninput="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">রক্তের গ্রুপ (Blood Group)</label>
                            <input type="text" id="bloodGroup" value="B+ (Positive)" oninput="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none">
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-xs font-medium text-slate-600 mb-1">স্থায়ী ঠিকানা (Permanent Address)</label>
                            <input type="text" id="permanentAddress" value="Village: Rasulpur, P.O: Kaliganj, Upazila: Sadar, District: Bogura" oninput="updateCV()" class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-bdGreen outline-none">
                        </div>
                    </div>
                </details>

                <!-- 7. References Section -->
                <details id="bdReferenceSection" class="bg-white rounded-xl shadow-sm border border-slate-200 group">
                    <summary class="flex justify-between items-center p-4 cursor-pointer font-semibold text-slate-800 group-open:border-b group-open:border-slate-100 select-none">
                        <span class="flex items-center gap-2 text-bdGreen">
                            <i class="fa-solid fa-users font-semibold"></i> রেফারেন্স (References)
                        </span>
                        <i class="fa-solid fa-chevron-down text-slate-400 group-open:rotate-180 transition-transform"></i>
                    </summary>
                    <div class="p-4 space-y-4 text-sm">
                        <div id="referenceList" class="space-y-4">
                            <!-- Dynamic References insert here -->
                        </div>
                        <button onclick="addReferenceItem()" class="w-full py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold flex items-center justify-center gap-2 border border-slate-300">
                            <i class="fa-solid fa-plus"></i> রেফারেন্স যোগ করুন
                        </button>
                    </div>
                </details>

            </div>
        </section>

        <!-- Right Column: Dynamic Live Preview Canvas -->
        <section class="lg:w-1/2 w-full flex flex-col items-center">
            <div class="w-full flex justify-between items-center mb-2 px-2 no-print">
                <span class="text-xs font-semibold text-slate-500 flex items-center gap-1.5">
                    <i class="fa-solid fa-eye text-bdGreen"></i> লাইভ সিভি প্রিভিউ (A4 Format)
                </span>
                <span id="pageCountBadge" class="text-xs bg-slate-200 text-slate-700 font-medium px-2.5 py-0.5 rounded-full">
                    ফরম্যাট: ১ পৃষ্ঠা
                </span>
            </div>

            <!-- CV Preview Outer Box -->
            <div class="cv-preview-container w-full overflow-x-auto pb-6">
                <!-- Dynamic Page Mount -->
                <div id="cvDocument" class="a4-page transition-all duration-300">
                    <!-- CV Content Rendered dynamically via JavaScript -->
                </div>
            </div>
        </section>

    </main>

    <!-- Footer Section -->
    <footer class="bg-white border-t border-slate-200 py-3 text-center text-xs text-slate-500 no-print">
        <p>বাংলাদেশের স্ট্যান্ডার্ড অনুযায়ী সিভি ও রেজুমে বিল্ডার | Designed for Bangladeshi Job Seekers</p>
    </footer>

